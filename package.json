{
  "name": "inkwell-blog",
  "version": "1.0.0",
  "private": true,
  "description": "A beginner-friendly blogging platform built with Express, MongoDB and Tailwind CSS v4 using the MVC pattern.",
  "main": "src/server.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:css\" \"npm:dev:server\"",
    "dev:server": "nodemon src/server.js",
    "dev:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/style.css --watch",
    "build": "tailwindcss -i ./src/styles/input.css -o ./public/css/style.css --minify",
    "start": "node src/server.js",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "method-override": "^3.0.0",
    "mongoose": "^8.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.4.0",
    "@tailwindcss/cli": "^4.0.0",
    "commitizen": "^4.3.0",
    "concurrently": "^8.2.2",
    "cz-conventional-changelog": "^3.3.0",
    "nodemon": "^3.1.4",
    "tailwindcss": "^4.0.0"
  }
}
