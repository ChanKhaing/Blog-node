# Copy this file to .env and fill in real values before running locally.
# When running with Docker Compose the MONGODB_URI below is set automatically;
# only SESSION_SECRET needs a real value.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# development | production
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# Docker Compose (uses the mongo_db service):
MONGODB_URI=mongodb://mongo_db:27017/blog_db

# MongoDB Atlas (cloud – comment the line above and uncomment this one):
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/blog_db?retryWrites=true&w=majority

# ── Session ─────────────────────────────────────────────────────────────────
# Generate a strong secret with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
