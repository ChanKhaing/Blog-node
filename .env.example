# Copy this file to .env and fill in real values.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/inkwell?retryWrites=true&w=majority

# Long random string used to sign session cookies.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Port used when running locally
PORT=3000

# development | production
NODE_ENV=development
