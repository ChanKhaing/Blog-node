<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="flex-1 grain-bg">
  <div class="mx-auto flex max-w-md flex-col px-5 py-16 sm:px-8">
    <span class="eyebrow self-start">Welcome back</span>
    <h1 class="mt-5 text-3xl font-bold text-ink-950">Log in to Inkwell</h1>
    <p class="mt-2 text-sm text-ink-600">Pick up right where you left off.</p>

    <form class="card mt-8 space-y-5 p-6 sm:p-8" method="POST" action="/login" novalidate>
      <%- include('../partials/errors', { errors: errors }) %>

      <div>
        <label class="label" for="email">Email address</label>
        <input class="field" id="email" name="email" type="email" autocomplete="email"
               placeholder="you@example.com" value="<%= values.email || '' %>" required />
      </div>

      <div>
        <label class="label" for="password">Password</label>
        <input class="field" id="password" name="password" type="password"
               autocomplete="current-password" placeholder="Your password" required />
      </div>

      <button type="submit" class="btn btn-primary w-full">Log in</button>

      <p class="text-center text-sm text-ink-600">
        New here?
        <a href="/register" class="font-semibold text-brand-strong hover:underline">Create an account</a>
      </p>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
