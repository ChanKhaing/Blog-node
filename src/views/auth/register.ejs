<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="flex-1 grain-bg">
  <div class="mx-auto flex max-w-md flex-col px-5 py-16 sm:px-8">
    <span class="eyebrow self-start">Create account</span>
    <h1 class="mt-5 text-3xl font-bold text-ink-950">Start writing on Inkwell</h1>
    <p class="mt-2 text-sm text-ink-600">All you need is an email address and a password.</p>

    <form class="card mt-8 space-y-5 p-6 sm:p-8" method="POST" action="/register" novalidate>
      <%- include('../partials/errors', { errors: errors }) %>

      <div>
        <label class="label" for="email">Email address</label>
        <input class="field" id="email" name="email" type="email" autocomplete="email"
               placeholder="you@example.com" value="<%= values.email || '' %>" required />
      </div>

      <div>
        <label class="label" for="password">Password</label>
        <input class="field" id="password" name="password" type="password" autocomplete="new-password"
               placeholder="At least 8 characters" minlength="8" required />
      </div>

      <div>
        <label class="label" for="confirmPassword">Confirm password</label>
        <input class="field" id="confirmPassword" name="confirmPassword" type="password"
               autocomplete="new-password" placeholder="Type the password again" minlength="8" required />
      </div>

      <button type="submit" class="btn btn-primary w-full">Create account</button>

      <p class="text-center text-sm text-ink-600">
        Already have an account?
        <a href="/login" class="font-semibold text-brand-strong hover:underline">Log in</a>
      </p>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
