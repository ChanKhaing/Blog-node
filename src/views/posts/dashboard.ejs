<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="flex-1">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="eyebrow">Your workspace</span>
        <h1 class="mt-5 text-4xl font-bold text-ink-950">Your posts</h1>
        <p class="mt-3 text-ink-600">Edit or delete anything you have written.</p>
      </div>
      <a href="/posts/new" class="btn btn-primary">New post</a>
    </div>

    <div class="mt-10">
      <%- include('../partials/blog-list', {
        posts: posts,
        showOwnerActions: true,
        emptyHeading: 'You have not written anything yet',
        emptyBody: 'Your published posts will appear here. Start with a title and a few paragraphs.',
        emptyCtaHref: '/posts/new',
        emptyCtaLabel: 'Write your first post'
      }) %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
