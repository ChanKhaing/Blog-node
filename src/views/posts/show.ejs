<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="flex-1">
  <article class="mx-auto max-w-3xl px-5 py-14 sm:px-8">
    <a href="/posts" class="text-sm font-semibold text-ink-600 transition-colors hover:text-ink-950">&larr; Back to all posts</a>

    <h1 class="mt-6 text-4xl font-bold leading-tight text-ink-950 sm:text-5xl"><%= post.title %></h1>

    <div class="mt-6 flex flex-wrap items-center gap-3 border-b border-ink-200 pb-6 text-sm text-ink-600">
      <span class="grid h-9 w-9 place-items-center rounded-full bg-brand-soft text-sm font-semibold text-brand-strong">
        <%= (post.author && post.author.email ? post.author.email[0] : '?').toUpperCase() %>
      </span>
      <span><%= post.author ? post.author.email : 'Unknown author' %></span>
      <span aria-hidden="true">&middot;</span>
      <time datetime="<%= post.createdAt.toISOString() %>">
        <%= post.createdAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
      </time>
      <% if (post.updatedAt > post.createdAt) { %>
        <span aria-hidden="true">&middot;</span>
        <span class="text-ink-400">
          Updated <%= post.updatedAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
        </span>
      <% } %>
    </div>

    <div class="mt-8 space-y-5 text-lg leading-relaxed text-ink-900">
      <% post.content.split(/\n\s*\n/).forEach(function (paragraph) { %>
        <p><%= paragraph %></p>
      <% }); %>
    </div>

    <% if (isOwner) { %>
      <div class="mt-12 flex flex-wrap items-center gap-3 rounded-2xl border border-ink-200 bg-white p-5">
        <p class="mr-auto text-sm text-ink-600">You wrote this post.</p>
        <a href="/posts/<%= post._id %>/edit" class="btn btn-secondary">Edit post</a>
        <form action="/posts/<%= post._id %>?_method=DELETE" method="POST"
              onsubmit="return confirm('Delete this post? This cannot be undone.');">
          <button type="submit" class="btn btn-danger">Delete post</button>
        </form>
      </div>
    <% } %>
  </article>
</main>

<%- include('../partials/footer') %>
