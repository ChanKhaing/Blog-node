<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="mx-auto mt-5 w-full max-w-6xl px-5 sm:px-8">
    <div
      class="rounded-xl border px-4 py-3 text-sm <%= flash.type === 'error'
        ? 'border-red-200 bg-red-50 text-red-800'
        : 'border-emerald-200 bg-emerald-50 text-emerald-800' %>"
      role="status"
    >
      <%= flash.message %>
    </div>
  </div>
<% } %>
