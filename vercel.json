{
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [
    { "src": "src/server.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/css/(.*)", "dest": "/public/css/$1" },
    { "src": "/(.*)", "dest": "/src/server.js" }
  ]
}
